# Scanova environment configuration
# Copy to .env and adjust values before running:  copy .env.example .env
#
# SECURITY: Never commit .env to git. All secrets live here only — not in code.

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Set true only for local development with default credentials
ALLOW_INSECURE_DEFAULTS=true

# Security — CHANGE THESE before any shared/production deployment
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SCANOVA_SECRET=
JWT_ALGORITHM=HS256
JWT_TOKEN_HOURS=24

# Admin seed (created on first run if missing)
ADMIN_EMAIL=admin@scanova.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Groq Explainable AI — get key from https://console.groq.com
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Upload & auth hardening
MAX_UPLOAD_MB=16
MIN_PASSWORD_LENGTH=8
RATE_LIMIT_LOGIN=10
RATE_LIMIT_WINDOW_SEC=900

# Storage (json | mysql — mysql is schema-only for now)
STORAGE_BACKEND=json
DATA_DIR=data

# Paths
MODELS_DIR=models
FRONTEND_DIR=frontend

# Future MySQL (not used while STORAGE_BACKEND=json)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=scanova
MYSQL_PASSWORD=
MYSQL_DATABASE=scanova
