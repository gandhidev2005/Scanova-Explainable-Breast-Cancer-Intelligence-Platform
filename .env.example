# Scanova environment configuration
# Copy to .env and fill in values:  copy .env.example .env
#
# SECURITY: Never commit .env to git.
# All API keys, passwords, and LLM model names live HERE only — not in Python code.

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Set true only for local development
ALLOW_INSECURE_DEFAULTS=true

# Security — CHANGE THESE before any shared/production deployment
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SCANOVA_SECRET=
JWT_ALGORITHM=HS256
JWT_TOKEN_HOURS=24

# Admin seed (created on first run if missing)
ADMIN_EMAIL=admin@scanova.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Groq Explainable AI — https://console.groq.com
# Set GROQ_API_KEY, GROQ_API_URL, and GROQ_MODEL in .env (no defaults in code)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama fallback when Groq fails / key missing
# Install: https://ollama.com   then:  ollama pull <model>
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Upload & auth hardening
MAX_UPLOAD_MB=16
MIN_PASSWORD_LENGTH=8
RATE_LIMIT_LOGIN=10
RATE_LIMIT_WINDOW_SEC=900

# Storage (json | mysql — mysql is schema-only for now)
STORAGE_BACKEND=json
DATA_DIR=data

# Paths
MODELS_DIR=models
FRONTEND_DIR=frontend

# Future MySQL (not used while STORAGE_BACKEND=json)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=scanova
MYSQL_PASSWORD=
MYSQL_DATABASE=scanova
